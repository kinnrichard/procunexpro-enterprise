# Copy to `.env` on the server, in the deploy directory, one per environment.
# Example values shown are for STAGING — change per env.

# Compose project name (isolates containers/volumes per env)
COMPOSE_PROJECT_NAME=procunex-staging

# Image tag to run: development | staging | production
IMAGE_TAG=staging

# Host ports (must be unique per env if several run on one VPS; put a reverse proxy in front)
API_PORT=5004
WEB_PORT=5005

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=procunexpro_enterprise

# App
JWT_SECRET=change-me-long-random-secret
JWT_EXPIRES_IN=1d
FRONTEND_URL=https://staging.procunex.example.com

# Email (optional — leave blank to use the Ethereal test account)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
