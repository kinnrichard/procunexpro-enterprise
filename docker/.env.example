# Copy to `.env` on the server, in the deploy directory, one per environment.
# Example values shown are for STAGING.
# Ingress/TLS is handled by the shared Traefik proxy (external `traefik_network`) —
# no host ports here; Traefik routes by APP_DOMAIN.

# Isolates containers/volumes/Traefik routers per env (also used in container names)
COMPOSE_PROJECT_NAME=procunex-staging

# Image tag to run: development | staging | production
IMAGE_TAG=staging

# The domain Traefik routes to this env (web at /, api at /api, uploads at /uploads).
# Point this A-record at the droplet; Traefik gets the Let's Encrypt cert automatically.
APP_DOMAIN=staging.procunex.example.com

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=procunexpro_enterprise

# App
JWT_SECRET=change-me-long-random-secret

# Email (optional — blank uses the Ethereal test account)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
